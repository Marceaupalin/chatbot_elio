# Clé API NVIDIA (build.nvidia.com > votre profil > API Keys). Elle commence en général par nvapi-
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle utilisé (identifiant exact affiché sur build.nvidia.com)
MODEL=nvidia/nemotron-3-super-120b-a12b

# Modèles de secours, séparés par des virgules : utilisés automatiquement si le modèle
# principal est retiré par NVIDIA ou saturé (aucune réponse sous 20 secondes).
FALLBACK_MODELS=openai/gpt-oss-20b

# Mettre true pour laisser le modèle « réfléchir » avant de répondre (plus lent).
THINKING=false

# Réglages de génération
TEMPERATURE=0.4
MAX_TOKENS=1024

# Port local de l'application (http://localhost:3000)
PORT=3000

# Mettre false pour ne pas ouvrir le navigateur automatiquement
OPEN_BROWSER=true

# Adresse de l'API (à ne changer que pour un autre fournisseur compatible OpenAI)
API_BASE_URL=https://integrate.api.nvidia.com/v1
